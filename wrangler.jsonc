{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "frc-colors",
	"main": "./worker.ts",
	"compatibility_date": "2026-09-11",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"routes": [
		{
			"pattern": "frc-colors.com/*",
			"zone_name": "frc-colors.com",
		},
		{
			"pattern": "www.frc-colors.com/*",
			"zone_name": "frc-colors.com",
		},
		{
			"pattern": "api.frc-colors.com/*",
			"zone_name": "frc-colors.com",
		},
	],
	"observability": {
		"enabled": true,
	},
}
