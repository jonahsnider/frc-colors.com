{
	"name": "frc-colors",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "vp build",
		"build:production": "convex deploy --cmd 'vp build'",
		"cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
		"deploy": "pnpm run build:production && pnpm run deploy:cloudflare",
		"deploy:cloudflare": "wrangler deploy",
		"dev": "pnpm run \"/^dev:(backend|frontend)$/\"",
		"dev:backend": "convex dev",
		"dev:frontend": "portless frc-colors.com vp dev",
		"format": "vp fmt --check",
		"format:fix": "vp fmt",
		"knip": "knip",
		"lint": "vp lint",
		"lint:fix": "vp lint --fix",
		"preview": "pnpm run build && vp preview",
		"start": "vp preview",
		"test": "pnpm run lint && pnpm run type-check && pnpm run build",
		"type-check": "tsc --noEmit && tsc -p convex/tsconfig.json"
	},
	"dependencies": {
		"@convex-dev/react-query": "0.1.0",
		"@convex-dev/workpool": "0.4.14",
		"@heroicons/react": "2.2.0",
		"@hono/zod-openapi": "1.6.3",
		"@jonahsnider/util": "13.0.0",
		"@radix-ui/colors": "3.0.0",
		"@radix-ui/react-icons": "1.3.2",
		"@radix-ui/themes": "3.3.0",
		"@tanstack/react-query": "5.104.5",
		"@tanstack/react-router": "1.170.46",
		"@tanstack/react-router-ssr-query": "1.167.3",
		"@tanstack/react-start": "1.169.4",
		"@uidotdev/usehooks": "2.4.1",
		"clsx": "2.1.1",
		"convex": "1.48.0",
		"convex-helpers": "0.1.129",
		"culori": "4.0.2",
		"date-fns": "4.4.0",
		"extract-colors": "4.2.1",
		"fetch-extras": "3.2.1",
		"hono": "4.13.13",
		"next-themes": "0.4.6",
		"pngjs": "7.0.0",
		"radix-themes-tw": "0.2.3",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"sonner": "2.0.8",
		"use-debounce": "10.1.1",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "1.65.0",
		"@types/culori": "4.0.1",
		"@types/node": "26.6.5",
		"@types/pngjs": "6.0.5",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.1.2",
		"autoprefixer": "10.6.1",
		"knip": "6.42.1",
		"portless": "0.15.10",
		"postcss": "8.5.31",
		"postcss-import": "17.0.1",
		"tailwindcss": "3.4.19",
		"type-fest": "5.10.0",
		"typescript": "7.0.2",
		"vite": "catalog:",
		"vite-plus": "catalog:",
		"wrangler": "4.152.0"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "26.x",
			"onFail": "warn"
		}
	},
	"packageManager": "pnpm@12.15.0"
}
