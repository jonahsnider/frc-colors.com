{
	"name": "frc-colors",
	"private": true,
	"type": "module",
	"workspaces": [
		"apps/*"
	],
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"format": "prettier --check .",
		"format:write": "pnpm run format --write",
		"lint": "biome check .",
		"lint:fix": "biome check . --write --unsafe",
		"migrate": "drizzle-kit migrate",
		"migrate:create": "drizzle-kit generate",
		"test": "pnpm run lint && turbo run build type-check",
		"type-check": "turbo run type-check"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.12",
		"drizzle-kit": "1.0.0-rc.5-ab785fc",
		"envalid": "8.2.0",
		"knip": "^6.0.0",
		"portless": "0.15.6",
		"prettier": "3.9.6",
		"prettier-plugin-packagejson": "3.0.2",
		"turbo": "2.10.12",
		"vercel": "59.11.2"
	},
	"packageManager": "pnpm@12.3.3",
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "26.x",
			"onFail": "warn"
		}
	}
}
