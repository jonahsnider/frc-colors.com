{
	"name": "frc-colors",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "NODE_ENV=production next build",
		"build:cloudflare": "opennextjs-cloudflare build",
		"build:production": "convex deploy --cmd 'pnpm run build:cloudflare' --cmd-url-env-var-name NEXT_PUBLIC_CONVEX_URL",
		"cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
		"deploy": "pnpm run build:production && pnpm run deploy:cloudflare",
		"deploy:cloudflare": "opennextjs-cloudflare deploy",
		"dev": "pnpm run \"/^dev:(backend|frontend)$/\"",
		"dev:backend": "convex dev",
		"dev:frontend": "WATCHPACK_POLLING=true portless frc-colors.com next dev",
		"format": "prettier --check .",
		"format:fix": "prettier --write .",
		"knip": "knip",
		"lint": "biome check .",
		"lint:fix": "biome check . --write --unsafe",
		"preview": "pnpm run build:cloudflare && opennextjs-cloudflare preview",
		"start": "NODE_ENV=production next start",
		"test": "pnpm run lint && pnpm run type-check && pnpm run build",
		"type-check": "tsc --noEmit && tsc -p convex/tsconfig.json"
	},
	"dependencies": {
		"@heroicons/react": "2.2.0",
		"@hono/zod-openapi": "1.6.3",
		"@jonahsnider/util": "13.0.0",
		"@radix-ui/colors": "^3.0.0",
		"@radix-ui/react-icons": "1.3.2",
		"@radix-ui/themes": "3.3.0",
		"@uidotdev/usehooks": "2.4.1",
		"clsx": "2.1.1",
		"convex": "^1.46.0",
		"convex-helpers": "0.1.124",
		"culori": "4.0.2",
		"date-fns": "4.4.0",
		"extract-colors": "4.2.1",
		"hono": "4.13.8",
		"ky": "2.1.0",
		"next": "16.3.6",
		"next-plausible": "4.0.0",
		"next-themes": "0.4.6",
		"next-view-transitions": "0.3.5",
		"nuqs": "2.10.1",
		"p-limit": "7.3.3",
		"pngjs": "7.0.0",
		"radix-themes-tw": "0.2.3",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"sonner": "2.0.8",
		"use-debounce": "10.1.1",
		"zod": "4.6.5"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@opennextjs/cloudflare": "1.20.6",
		"@types/culori": "4.0.1",
		"@types/node": "26.6.2",
		"@types/pngjs": "6.0.5",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"autoprefixer": "10.6.1",
		"knip": "^6.0.0",
		"portless": "0.15.6",
		"postcss": "8.5.28",
		"postcss-import": "17.0.0",
		"prettier": "3.9.9",
		"prettier-plugin-packagejson": "3.0.2",
		"tailwindcss": "3.4.19",
		"type-fest": "5.10.0",
		"typescript": "7.0.2",
		"wrangler": "4.137.0"
	},
	"packageManager": "pnpm@12.6.0",
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "26.x",
			"onFail": "warn"
		}
	}
}
