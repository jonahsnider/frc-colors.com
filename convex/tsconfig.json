{
	"compilerOptions": {
		"allowJs": true,
		"strict": true,
		"moduleResolution": "Bundler",
		"allowImportingTsExtensions": true,
		"jsx": "react-jsx",
		"skipLibCheck": true,
		"allowSyntheticDefaultImports": true,
		"types": ["node"],
		"target": "ESNext",
		"lib": ["ES2023", "dom"],
		"forceConsistentCasingInFileNames": true,
		"module": "ESNext",
		"isolatedModules": true,
		"noEmit": true
	},
	"include": ["./**/*"],
	"exclude": ["./_generated"]
}
